{
  "manifest_version": 3,
  "name": "Pocket Speechify",
  "version": "0.1.0",
  "description": "Text-to-speech with a floating pill player",
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "permissions": [],
  "web_accessible_resources": [
    {
      "resources": ["src/*.js", "css/*.css"],
      "matches": ["<all_urls>"]
    }
  ]
}
